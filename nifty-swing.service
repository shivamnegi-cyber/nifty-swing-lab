[Unit]
Description=NIFTY Swing Lab — one trading cycle
After=network-online.target
Wants=network-online.target

[Service]
# One run per trigger (the timer fires it at each NSE trading time). Each run is
# independent and self-healing, so a crash is recovered by the next trigger.
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/nifty-swing-lab
EnvironmentFile=/home/ubuntu/nifty-swing-lab/.env
ExecStart=/home/ubuntu/nifty-swing-lab/venv/bin/python run_cycle.py
# retry a failed run up to 3 times, 2 min apart, before waiting for the next trigger
Restart=on-failure
RestartSec=120
StartLimitIntervalSec=900
StartLimitBurst=3
